# Postgres (pgvector) connection string
DNS_CONN_DEV=postgres://postgres:password@localhost:5432/music?sslmode=disable

# OpenAI API key, used for chat, quiz generation and embeddings
OPENAI=

# AWS Cognito user pool, used for auth
AWS_REGION=us-west-1
USER_POOL_ID=
USER_POOL_CLIENT_ID=

# Canvas LMS integration (only needed for the canvas tests)
CANVAS_API=
CANVAS_SUBDOMAIN=
CANVAS_COURSE_ID=

# domain for auth cookies in production, e.g. example.com
COOKIE_DOMAIN=

# set to 1 to see debug logs
DEBUG=
